extends layouts/base.pug

block content

    // Masthead
    header.masthead
        .container.px-4.px-lg-5.d-flex.h-100.align-items-center.justify-content-center
            .d-flex.justify-content-center
                .text-center
                    h2.text-white-80.mx-auto.mb-5.mt-5.text-uppercase &nbsp; &nbsp; Gregor Ehrensperger
                    h1.mx-auto.my-0.mt-5.text-uppercase AI &middot; DEV &middot; MATH
                    h4.text-white-50.mx-auto.mt-2.mb-5 Navigating the realms where algorithms blaze, seeking knowledge in a data-driven maze
                    a.btn.btn-primary(href='#about') About Me

    // Latest blog posts
    section#latest-posts.blog-section.bg-light
        .container.px-4.px-lg-5
            .row.justify-content-center
                .col-lg-8
                    h2.blog-section__title.text-uppercase.mb-5 Latest blog posts
                    if latestPosts && latestPosts.length
                        ul.blog-index.list-unstyled
                            each post in latestPosts
                                li.blog-index__item
                                    a.blog-index__link(href=`blog/${post.slug}.html`)
                                        h3.blog-index__post-title= post.title
                                    time.blog-index__date(datetime=post.dateIso)= post.dateFormatted
                                    p.blog-badges
                                        each cat in post.categories
                                            span.blog-badge(class=`blog-badge--${cat.toLowerCase()}`)= cat
                                    if post.excerpt
                                        p.blog-index__excerpt.text-black-50= post.excerpt
                        .text-center.mt-4
                            a.btn.btn-primary(href='blog/') View all posts
                    else
                        p.text-black-50 No posts yet.

    // Projects
    section#about.projects-section.bg-light
        .container.px-4.px-lg-5
            // Featured Project Row
            .row.gx-0.mb-4.mb-lg-5.align-items-center
                .col-xl-8.col-lg-7
                    img.img-fluid.mb-3.mb-lg-0(src='assets/img/greh3.jpg', alt='...')
                .col-xl-4.col-lg-5
                    .featured-text.text-center.text-lg-left
                        h4 About me
                        p.text-black-50.mb-0
                            | Hej there! My name is Gregor, I was born in the beautiful Tyrolian Alps in 1986 and I reside near Innsbruck, Austria.
                            | I am a
                            u
                                span.has-footnote(title="Roughly two decades experience in various industry sectors and programming languages such as C++, Julia, Python, R.") software engineer
                            | with a strong
                            u
                                span.has-footnote(title="Embracing clean code, best-practices in usage of control versioning systems, conventional commit messages, semantical version numbering to ensure faster delivery, higher quality, and more reliable software systems.") DevOps
                            | mindset,
                            u
                                span.has-footnote(title="Started in 2011 with AI and ML. Expertise in a wide array of techniques from traditional models such as k-means, SVM, random forest to advanced methods including XGBoost and various neural network variants.") data scientist,
                            u
                                span.has-footnote(title="Publications in the fields of computer vision, explainable AI, machine learning, and extreme value statistics.") researcher,
                            | and
                            u
                                span.has-footnote(title="Lectures on Software, Programming, Mathematics and Data Science at the University of Innsbruck and on Data Science at the MCI in Innsbruck") lecturer
                            |   with an academic background in mathematics and computer science.
                            br
                            br
                            | I am passionate about sharing knowledge and love to jointly work on challenging problems.
                            br
                            br
                            | Whether you are looking for assistance with a
                            u
                                span.has-footnote(title="Software Engineering, Optimization, Modelling") complex technical challenge
                            | aiming to
                            u
                                span.has-footnote(title="Artificial Intelligence, Data Engineering and Science, Machine Learning, DevOps") enhance your skills
                            | guided by external expertise in a mentoring or workshop setting, or looking for a helping hand with a
                            u
                                span.has-footnote(title="Applied Data Science and Machine Learning, Software Engineering, Writing") research topic,
                            | I would be thrilled to
                            b
                                a(href='#contact') connect
                            |  and explore potential collaborations.
            // Project One Row
            .row.gx-0.mb-5.mb-lg-0.justify-content-center
                .col-lg-6
                    img.img-fluid(src='assets/img/ai.jpg', alt='...')
                .col-lg-6
                    .bg-black.text-center.h-100.project
                        .d-flex.h-100
                            .project-text.w-100.my-auto.text-center.text-lg-left
                                h4.text-white AI
                                p.mb-0.text-white-50
                                    | In 2011 I attended the very first edition of the famous MOOC Artificial Intelligence by Sebastian Thrun and Peter Norvig and was proud to rank among the top 1000 students (160.000 signed up for the course).
                                    | I was immediately captivated by AI related topics and in the following years I took every opportunity to upskill in this field.
                                    | I attended related conferences, took more university and online courses and worked on many Data Science / AI projects professionally.
                                    | Since 2019, I have been teaching in the Master's programme Data Science at the University of Innsbruck and since 2025 in the Master's programme Mechantronics at the MCI in Innsbruck.
                                    | Starting in 2021, I began pursuing a PhD in Mathematics at the same university, focusing on explainable artificial intelligence and extreme value statistics.
                                hr.d-none.d-lg-block.mb-0.ms-0
            // Project Two Row
            .row.gx-0.justify-content-center
                .col-lg-6
                    img.img-fluid(src='assets/img/dev.jpg', alt='...')
                .col-lg-6.order-lg-first
                    .bg-black.text-center.h-100.project
                        .d-flex.h-100
                            .project-text.w-100.my-auto.text-center.text-lg-right
                                h4.text-white DEV
                                p.mb-0.text-white-50
                                    | The development of stable software packages is quite an art. I love to craft software, tweak algorithms, improve performance and stability. I am a DevOps evangelist and very keen about enabling developers to unlock their full potential. I hold a Bachelor degree in Computer Science and worked as a Senior Software Engineer for several years.
                                hr.d-none.d-lg-block.mb-0.me-0
            // Project Three Row
            .row.gx-0.mb-5.mb-lg-0.justify-content-center
                .col-lg-6
                    img.img-fluid(src='assets/img/math.jpg', alt='...')
                .col-lg-6
                    .bg-black.text-center.h-100.project
                        .d-flex.h-100
                            .project-text.w-100.my-auto.text-center.text-lg-left
                                h4.text-white MATH
                                p.mb-0.text-white-50
                                    | "Mathematics is the language in which God has written the universe" (Galileo Galilei).
                                    | This might be exaggerated but having a profound understanding of mathematics is incredibly valuable, particularly in fields like AI and Data Science.
                                    | As a graduate in Technical Mathematics I always strive to understand the theory and limits of the utilized methods.
                                    | With a solid theoretical background and h ands-on experience in real-world settings, my toolbox is not limited to the blind application of modern AI tools.
                                hr.d-none.d-lg-block.mb-0.ms-0

    // Publications
    section#publications.publications-section.bg-light
        .container.px-4.px-lg-5
            .row.justify-content-center
                .col-lg-8
                    h2.publications-section__title.text-uppercase.mb-5 Publications & Course Materials

                    h3.mb-3 Publications
                    .publications-list
                        .publications-list__item.mb-4
                            a(href='https://doi.org/10.1016/j.wace.2026.100916') Building a high-resolution hail database for Austria and estimating hail hazard using a metastatistical approach
                            span.d-block.text-black-50 2026
                            span.d-block.small.text-black-50 Weather and Climate Extremes (Elsevier)
                            a(href='https://github.com/noxthot/hailriskat_paper') Code

                        .publications-list__item.mb-4
                            a(href='https://doi.org/10.5194/gmd-18-1141-2025') Identifying Lightning Processes in ERA5 Soundings with Deep Learning
                            span.d-block.text-black-50 2025
                            span.d-block.small.text-black-50 Geoscientific Model Development (Copernicus Publications)
                            a(href='https://github.com/noxthot/xai_lightningprocesses') Code

                        .publications-list__item.mb-4
                            a(href='https://doi.org/10.1016/j.wace.2023.100601') Accounting for seasonality in the metastatistical extreme value distribution
                            span.d-block.text-black-50 2023
                            span.d-block.small.text-black-50 Weather and Climate Extremes (Elsevier)
                            a(href='https://github.com/Falke96/extreme_precipitation_austria') Code

                        .publications-list__item.mb-4
                            a(href='https://doi.org/10.1007/978-3-030-30487-4_23') Evaluating CNNs on the Gestalt Principle of Closure
                            span.d-block.text-black-50 2019
                            span.d-block.small.text-black-50 ICANN 2019 — Springer (Lecture Notes in Computer Science, vol 11727)

                        .publications-list__item.mb-4
                            a(href='https://doi.org/10.48550/arXiv.1504.01052') Fast algorithms for morphological operations using run-length encoded binary images
                            span.d-block.text-black-50 2015
                            span.d-block.small.text-black-50 arXiv preprint

                    h3.mb-3.mt-5 Workshop and Course Materials
                    ul.publications-list__workshops
                        li.mb-2
                            a(href='https://noxthot.github.io/ws26_industrial_datascience_manuscript/') Industrial Data Science
                            |  — Master of Mechatronics, Management Center Innsbruck, Winter term 2026
                        li.mb-2
                            a(href='https://noxthot.github.io/ws25_industrial_datascience_manuscript/') Industrial Data Science
                            |  — Master of Mechatronics, Management Center Innsbruck, Winter term 2025
                        li.mb-2
                            a(href='https://kandolfp.github.io/ws23_ulg_vu_ama_performance/') Performance Topics, Parallel and Remote Computing in Julia
                            |  — Master of Data Science, University of Innsbruck, Winter term 2023
                        li.mb-2
                            a(href='https://noxthot.github.io/ws22_ulg_ds_julia/') Introductionary Data Science with Julia
                            |  — Master of Data Science, University of Innsbruck, Winter term 2022
                        li.mb-2
                            a(href='https://noxthot.github.io/ss22_julia_workshop/') Scientific Coding with Julia
                            |  — Doctoral College Computational Interdisciplinary Modelling, University of Innsbruck, Summer School 2022
                        li.mb-2
                            a(href='https://discdown.org/fabulousjulia/') Scientific Coding with Julia
                            |  — Master of Data Science, University of Innsbruck, 2022
                        li.mb-2
                            a(href='https://github.com/noxthot/teaching_ss21_python_introduction_linguists') Introductory Python Workshop for Linguists
                            |  — University of Innsbruck, 2021 — only exercises

    // Contact
    section#contact.contact-section.bg-black
        .container.px-4.px-lg-5
            .row.gx-4.gx-lg-5
                .col-md-6.mb-3.mb-md-0
                    .card.py-4.h-100
                        .card-body.text-center
                            i.fas.fa-map-marked-alt.text-primary.mb-2
                            h4.text-uppercase.m-0 Address
                            hr.my-4.mx-auto
                            .small.text-black-50 6094 Axams, Austria
                .col-md-6.mb-3.mb-md-0
                    .card.py-4.h-100
                        .card-body.text-center
                            i.fas.fa-envelope.text-primary.mb-2
                            h4.text-uppercase.m-0 Email
                            hr.my-4.mx-auto
                            .small.text-black-50
                                a(href='mailto:g@ehrensperger.dev?subject=Hej you!&body=Reaching out via ehrensperger.dev') g@ehrensperger.dev
            .social.d-flex.justify-content-center
                a.mx-2(href='https://www.linkedin.com/in/gregor-ehrensperger/')
                    i.fab.fa-linkedin
                a.mx-2(href='https://github.com/noxthot')
                    i.fab.fa-github
                a.mx-2(href='https://www.facebook.com/gregor.ehrensperger/')
                    i.fab.fa-facebook
